rules_version = '2';

// Dividend Tracker: each signed-in user can reach only their own data,
// and every write is checked field by field. Anything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Optional-field checks: a field may be missing, but if present it must have the right type.
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optNum(d, k)      { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] < 1000000000000); }
    function optBool(d, k)     { return !(k in d) || d[k] is bool; }
    function optDay(d, k)      { return !(k in d) || (d[k] is string && d[k].matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')); }
    function optTime(d, k)    { return !(k in d) || d[k] is timestamp; }

    function validDividend() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ticker', 'amount', 'shares', 'date', 'account', 'notes', 'drip', 'dripPrice', 'tax', 'createdAt'])
        && d.keys().hasAll(['ticker', 'amount', 'date'])
        && d.ticker is string && d.ticker.size() > 0 && d.ticker.size() <= 20
        && d.amount is number && d.amount > 0 && d.amount < 1000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optNum(d, 'shares') && optNum(d, 'dripPrice') && optNum(d, 'tax')
        && optStr(d, 'account', 200) && optStr(d, 'notes', 200)
        && optBool(d, 'drip') && optTime(d, 'createdAt');
    }

    function validHolding() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ticker', 'name', 'sector', 'account', 'shares', 'cost', 'dps', 'freq', 'nextPay', 'exDate', 'price', 'createdAt'])
        && d.keys().hasAll(['ticker'])
        && d.ticker is string && d.ticker.size() > 0 && d.ticker.size() <= 20
        && optStr(d, 'name', 200) && optStr(d, 'sector', 200) && optStr(d, 'account', 200)
        && optNum(d, 'shares') && optNum(d, 'cost') && optNum(d, 'dps') && optNum(d, 'price')
        && (!('freq' in d) || d.freq in [1, 2, 4, 12])
        && optDay(d, 'nextPay') && optDay(d, 'exDate') && optTime(d, 'createdAt');
    }

    function validTransaction() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ticker', 'account', 'type', 'shares', 'price', 'date', 'opening', 'drip', 'payId', 'createdAt'])
        && d.keys().hasAll(['ticker', 'type', 'shares', 'price', 'date'])
        && d.ticker is string && d.ticker.size() > 0 && d.ticker.size() <= 20
        && d.type in ['buy', 'sell']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optNum(d, 'shares') && optNum(d, 'price')
        && optStr(d, 'account', 200) && optStr(d, 'payId', 200)
        && optBool(d, 'opening') && optBool(d, 'drip') && optTime(d, 'createdAt');
    }

    function validWatch() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ticker', 'name', 'notes', 'target', 'dir', 'createdAt'])
        && d.keys().hasAll(['ticker'])
        && d.ticker is string && d.ticker.size() > 0 && d.ticker.size() <= 20
        && optStr(d, 'name', 200) && optStr(d, 'notes', 200) && optNum(d, 'target')
        && (!('dir' in d) || d.dir in ['below', 'above'])
        && optTime(d, 'createdAt');
    }

    function validSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['finnhubKey', 'massiveKey', 'goal', 'skips'])
        && optStr(d, 'finnhubKey', 200) && optStr(d, 'massiveKey', 200) && optNum(d, 'goal')
        && (!('skips' in d) || (d.skips is map && d.skips.size() <= 5000));
    }

    function validSnapshot() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'value', 'basis'])
        && d.keys().hasAll(['date', 'value'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optNum(d, 'value') && optNum(d, 'basis');
    }

    match /users/{uid}/dividends/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validDividend();
    }
    match /users/{uid}/holdings/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validHolding();
    }
    match /users/{uid}/transactions/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTransaction();
    }
    match /users/{uid}/watchlist/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validWatch();
    }
    match /users/{uid}/settings/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings();
    }
    match /users/{uid}/snapshots/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSnapshot();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
